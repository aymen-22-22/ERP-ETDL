# Production environment for cPanel / Passenger deployment.
# Copy to `.env` ON THE SERVER (next to passenger_wsgi.py) and fill in.
# Never commit the real file — it holds the signing key and database password.

ENVIRONMENT=production
DEBUG=false
SQL_ECHO=false

# --- Database -------------------------------------------------------------
# Your remote PostgreSQL. Must be the asyncpg driver.
# TLS is enforced automatically in production for non-local hosts (see
# shared/core/config.py), so `?ssl=require` is added if you don't specify one.
DATABASE_URL=postgresql+asyncpg://DB_USER:DB_PASSWORD@db.example.com:5432/DB_NAME

# Pool sizing. Passenger forks several worker processes and EACH builds its own
# pool, so the real connection count is about (POOL_SIZE + MAX_OVERFLOW) x
# workers. Keep these low or you will hit the remote server's connection limit.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=900

# --- Security -------------------------------------------------------------
# REQUIRED. The app refuses to start in production with the placeholder value.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=REPLACE_ME_WITH_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS -----------------------------------------------------------------
# The exact origin(s) the frontend is served from — scheme + host, no trailing
# slash. A mismatch here is the usual cause of "blocked by CORS policy".
CORS_ORIGINS=["https://stock.etdledger.com"]

# --- Redis (optional) -----------------------------------------------------
# Shared hosting usually has no Redis. Leaving this unreachable is safe: the
# cache and rate limiter fail open behind a short circuit breaker, so requests
# still succeed — you simply lose rate limiting.
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE=60
