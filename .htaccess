# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot "/home/qrtvfyrp/stock.etdledger.com"
PassengerBaseURI "/api"
PassengerPython "/home/qrtvfyrp/virtualenv/stock.etdledger.com/3.14/bin/python"
PassengerAppLogFile "/home/qrtvfyrp/logs/erpapp.log"
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END

RewriteEngine On

# Hand /api straight to Passenger and stop — must precede the SPA fallback.
RewriteCond %{REQUEST_URI} ^/api
RewriteRule ^ - [L]

# CI deploy extracts dist straight into the doc root.
RewriteCond %{REQUEST_URI} \.(css|js|woff2?|ttf|eot|svg|png|jpe?g|gif|ico|webp|map)$ [OR]
RewriteCond %{REQUEST_URI} ^/assets/
RewriteRule ^ %{REQUEST_URI} [L]

# Real files (built assets) are served as-is.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else is the SPA.
RewriteRule ^ index.html [L]
