{
  "ci": {
    "collect": {
      "staticDistDir": "dist",
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:pwa": ["warn", { "minScore": 0.9 }],
        "installable-manifest": "warn",
        "service-worker": "warn",
        "offline-start-url": "warn",
        "categories:performance": ["warn", { "minScore": 0.5 }],
        "interactive": ["warn", { "maxNumericValue": 2000 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci"
    }
  }
}
