# Production API base URL — inlined by Vite at BUILD time (changing it on the
# server has no effect; you must rebuild).
#
# The mount point lives here, not in the request paths. API calls are written
# mount-relative ("/v1/products"), so:
#
#   production : "/api" + "/v1/products" -> /api/v1/products
#                Passenger (PassengerBaseURI "/api") strips "/api", so the app
#                receives "/v1/products" — which is what it serves.
#   local dev  : base falls back to http://localhost:8000 (see services/api/config.ts)
#                -> http://localhost:8000/v1/products, served directly by uvicorn.
#
# Same code, both environments. Leaving this empty would send "/v1/..." to the
# document root, which Apache serves as index.html instead of the API.
VITE_API_BASE_URL=/api
