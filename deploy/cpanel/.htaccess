# cPanel / CloudLinux Passenger — deployed copy of the document-root .htaccess.
#
# Lives at:  ~/<domain>/.htaccess   (e.g. ~/stock.etdledger.com/.htaccess)
# NOT auto-deployed — copy it by hand after changing it here.
#
# The CloudLinux block is regenerated by cPanel whenever the Python app is
# created or recreated; the paths below are examples, keep whatever cPanel
# wrote. Everything after it is hand-maintained.
#
# Two mistakes cost hours the first time, both fixed below:
#
#  1. `RewriteRule ^api/(.*)$ /api/$1 [L,QSA]` rewrote /api/x to itself. In
#     .htaccess context Apache re-runs the ruleset after a substitution, so it
#     matched forever and Apache returned 500 after 10 internal redirects. It
#     was also redundant — PassengerBaseURI already routes /api.
#
#  2. The SPA fallback ran before /api was excluded, so API calls were being
#     rewritten to index.html. The /api rule MUST come first.

# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot "/home/qrtvfyrp/erpapp"
PassengerBaseURI "/api"
PassengerPython "/home/qrtvfyrp/virtualenv/erpapp/3.14/bin/python"
PassengerAppLogFile "/home/qrtvfyrp/logs/erpapp.log"
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END

RewriteEngine On

# Hand /api straight to Passenger and stop — must precede the SPA fallback.
RewriteCond %{REQUEST_URI} ^/api
RewriteRule ^ - [L]

# Real files (built assets) are served as-is.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else is the SPA.
RewriteRule ^ index.html [L]
